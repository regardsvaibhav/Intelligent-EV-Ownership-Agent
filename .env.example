# Gnani API key for Prisma (STT) and Timbre (TTS)
GNANI_API_KEY=replace_with_your_gnani_api_key

# Optional: where per-turn JSONL logs go. Leave empty to disable logging.
EV_AGENT_LOG_PATH=logs/turns.jsonl

# Optional: web server port
PORT=5000

# Optional: abuse/cost limits for a public deployment
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MIN=30
MAX_SESSIONS=2000

# Optional: free LLM fallback for questions the rules don't understand.
# Free Gemini key: https://aistudio.google.com/apikey . Leave empty to stay fully rule-based.
LLM_API_KEY=
# Defaults to Google Gemini. For Groq instead:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a Groq model id from console.groq.com/docs/models>
# LLM_MODEL=gemini-3.8-flash
# LLM_TIMEOUT_SEC=8
# LLM_FALLBACK=0           # turn it off even when a key is set
